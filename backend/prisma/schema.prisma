}

model SystemSettings {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt
  updatedBy String?  @db.Uuid

  @@map("system_settings")
}

model FinancialAllocation {
  id          String              @id @default(uuid()) @db.Uuid
  orgId       String              @db.Uuid
  amount      Decimal
  allocationType AllocationType
  expenseId   String?             @db.Uuid
  paymentId   String?             @db.Uuid
  payRunId    String?             @db.Uuid
  siteId      String?             @db.Uuid
  createdById String              @db.Uuid
  notes       String?
  createdAt   DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime            @updatedAt @db.Timestamptz(6)
  org         Organization        @relation(fields: [orgId], references: [id], onDelete: Restrict)
  expense     Expense?            @relation("AllocationExpense", fields: [expenseId], references: [id], onDelete: Restrict)
  payment     Payment?            @relation("AllocationPayment", fields: [paymentId], references: [id], onDelete: Restrict)
  payRun      PayRun?             @relation("AllocationPayRun", fields: [payRunId], references: [id], onDelete: Restrict)
  site        Site?               @relation(fields: [siteId], references: [id], onDelete: Restrict)
  createdBy   User                @relation("FinancialAllocationCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([orgId, allocationType], map: "idx_financial_allocations_org_type")
  @@index([expenseId], map: "idx_financial_allocations_expense_id")
  @@index([paymentId], map: "idx_financial_allocations_payment_id")
  @@index([payRunId], map: "idx_financial_allocations_pay_run_id")
  @@index([siteId], map: "idx_financial_allocations_site_id")
  @@map("financial_allocations")
}

model ExpenseApproval {
  id         String                @id @default(uuid()) @db.Uuid
  orgId      String                @db.Uuid
  expenseId  String                @db.Uuid
  action     ExpenseApprovalAction
  actorId    String                @db.Uuid
  notes      String?
  createdAt  DateTime              @default(now()) @db.Timestamptz(6)
  org        Organization          @relation(fields: [orgId], references: [id], onDelete: Restrict)
  expense    Expense               @relation(fields: [expenseId], references: [id], onDelete: Restrict)
  actor      User                  @relation("ExpenseApprovalActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([orgId, expenseId], map: "idx_expense_approvals_org_expense")
  @@index([actorId], map: "idx_expense_approvals_actor_id")
  @@map("expense_approvals")
}

model FinancialEvidence {
  id           String   @id @default(uuid()) @db.Uuid
  orgId        String   @db.Uuid
  expenseId    String?  @db.Uuid
  paymentId    String?  @db.Uuid
  payRunId     String?  @db.Uuid
  storageKey   String
  sha256       String
  mimeType     String
  byteSize     Int
  uploadedById String   @db.Uuid
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  org          Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)
  expense      Expense? @relation("EvidenceExpense", fields: [expenseId], references: [id], onDelete: Restrict)
  payment      Payment? @relation("EvidencePayment", fields: [paymentId], references: [id], onDelete: Restrict)
  payRun       PayRun? @relation(fields: [payRunId], references: [id], onDelete: Restrict)
  uploadedBy   User @relation("FinancialEvidenceUploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([orgId], map: "idx_financial_evidence_org_id")
  @@index([expenseId], map: "idx_financial_evidence_expense_id")
  @@index([paymentId], map: "idx_financial_evidence_payment_id")
  @@index([payRunId], map: "idx_financial_evidence_pay_run_id")
  @@map("financial_evidence")
}

model Plan {
  id                String         @id @default(uuid()) @db.Uuid
  code              String         @unique
  name              String
  description       String?
  amountMinor       BigInt
  currency          String         @default("INR")
  interval          PlanInterval   @default(MONTH)
  trialDays         Int            @default(0)
  featureLimits     Json
  isActive          Boolean        @default(true)
  createdAt         DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime       @updatedAt @db.Timestamptz(6)
  subscriptions     Subscription[]

  @@map("plans")
}

model Subscription {
  id                    String             @id @default(uuid()) @db.Uuid
  orgId                 String             @db.Uuid
  planId                String             @db.Uuid
  status                SubscriptionStatus @default(TRIALING)
  provider              String             @default("razorpay")
  providerCustomerId    String?
  providerSubscriptionId String?
  currentPeriodStart    DateTime           @db.Timestamptz(6)
  currentPeriodEnd      DateTime           @db.Timestamptz(6)
  trialEndsAt           DateTime?          @db.Timestamptz(6)
  cancelAtPeriodEnd      Boolean            @default(false)
  unlimitedAccess       Boolean            @default(false)
  changedById            String?            @db.Uuid
  createdAt             DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime           @updatedAt @db.Timestamptz(6)
  org                   Organization       @relation(fields: [orgId], references: [id], onDelete: Restrict)
  plan                  Plan               @relation(fields: [planId], references: [id], onDelete: Restrict)
  changedBy             User?              @relation("SubscriptionChangedBy", fields: [changedById], references: [id], onDelete: Restrict)
  entitlements          Entitlement[]
  usageRecords          UsageRecord[]
  invoices              Invoice[]
  paymentEvents         PaymentEvent[]

  @@index([orgId, status], map: "idx_subscriptions_org_status")
  @@index([planId], map: "idx_subscriptions_plan_id")
  @@index([providerSubscriptionId], map: "idx_subscriptions_provider_id")
  @@index([status, currentPeriodEnd], map: "idx_subscriptions_status_period_end")
  @@map("subscriptions")
}

model Entitlement {
  id             String        @id @default(uuid()) @db.Uuid
  orgId          String        @db.Uuid
  subscriptionId String?       @db.Uuid
  key            String
  value          Json
  source         String        @default("PLAN")
  expiresAt      DateTime?     @db.Timestamptz(6)
  createdAt      DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @db.Timestamptz(6)
  org            Organization  @relation(fields: [orgId], references: [id], onDelete: Restrict)
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)

  @@unique([orgId, key], map: "uq_entitlements_org_key")
  @@index([subscriptionId], map: "idx_entitlements_subscription_id")
  @@map("entitlements")
}

model UsageRecord {
  id             String        @id @default(uuid()) @db.Uuid
  orgId          String        @db.Uuid
  subscriptionId String?       @db.Uuid
  metric         String
  periodStart    DateTime      @db.Timestamptz(6)
  periodEnd      DateTime      @db.Timestamptz(6)
  quantity       Decimal       @default(0)
  createdAt      DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @db.Timestamptz(6)
  org            Organization  @relation(fields: [orgId], references: [id], onDelete: Restrict)
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)

  @@unique([orgId, metric, periodStart, periodEnd], map: "uq_usage_org_metric_period")
  @@index([orgId, metric], map: "idx_usage_org_metric")
  @@index([subscriptionId], map: "idx_usage_subscription_id")
  @@map("usage_records")
}

// Durable idempotency + history anchor for Mail Supply sends (blueprint §J).
// The globally-unique idempotencyKey makes a retried request return the original
// result without re-charging quota or re-sending. PENDING → COMPLETED; a stuck
// PENDING row (process died mid-send) is surfaced as MAIL_DISPATCH_IN_PROGRESS.
model MailDispatch {
  id             String        @id @default(uuid()) @db.Uuid
  orgId          String?       @db.Uuid
  idempotencyKey String        @unique(map: "mail_dispatches_idempotencyKey_key")
  status         String        @default("PENDING")
  subject        String
  targetType     String
  targetRole     String?
  targetUserId   String?       @db.Uuid
  recipientCount Int           @default(0)
  sent           Int           @default(0)
  failed         Int           @default(0)
  blocked        Int           @default(0)
  actorId        String?       @db.Uuid
  createdAt      DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @db.Timestamptz(6)
  org            Organization? @relation(fields: [orgId], references: [id], onDelete: Restrict)

  @@index([orgId, createdAt], map: "idx_mail_dispatch_org_created")
  @@map("mail_dispatches")
}

model Invoice {
  id                 String          @id @default(uuid()) @db.Uuid
  orgId              String          @db.Uuid
  subscriptionId     String?         @db.Uuid
  invoiceNumber        String
  providerInvoiceId    String?
  providerOrderId      String?
  status               InvoiceStatus      @default(DRAFT)
  subtotalMinor      BigInt
  taxMinor           BigInt          @default(0)
  totalMinor         BigInt
  currency           String          @default("INR")
  issuedAt           DateTime        @default(now()) @db.Timestamptz(6)
  dueAt              DateTime?       @db.Timestamptz(6)
  paidAt             DateTime?       @db.Timestamptz(6)
  createdAt          DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime        @updatedAt @db.Timestamptz(6)
  org                Organization    @relation(fields: [orgId], references: [id], onDelete: Restrict)
  subscription       Subscription?   @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)

  @@unique([orgId, invoiceNumber], map: "uq_invoices_org_number")
  @@unique([providerInvoiceId], map: "uq_invoices_provider_id")
  @@unique([providerOrderId], map: "uq_invoices_provider_order_id")
  @@index([orgId, status], map: "idx_invoices_org_status")
  @@index([subscriptionId], map: "idx_invoices_subscription_id")
  @@map("invoices")
}

model PaymentEvent {
  id                   String             @id @default(uuid()) @db.Uuid
  orgId                String?            @db.Uuid
  subscriptionId       String?            @db.Uuid
  provider             String
  providerEventId      String
  eventType            String
  payload              Json
  status                PaymentEventStatus @default(RECEIVED)
  processedAt          DateTime?          @db.Timestamptz(6)
  failureReason        String?
  createdAt            DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime           @updatedAt @db.Timestamptz(6)
  org                  Organization?      @relation(fields: [orgId], references: [id], onDelete: Restrict)
  subscription         Subscription?     @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)

  @@unique([provider, providerEventId], map: "uq_payment_events_provider_event")
  @@index([orgId, status], map: "idx_payment_events_org_status")
  @@index([subscriptionId], map: "idx_payment_events_subscription_id")
  @@map("payment_events")
}

// Cross-company membership (blueprint §L). Additive and dormant: nothing reads
// this table unless MULTI_COMPANY_ENABLED=true, in which case an ACTIVE row
// grants the user tenant access to that company in addition to user.orgId.
// The primary org stays user.orgId — membership rows never move the primary.
model Membership {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid
  orgId     String           @db.Uuid
  role      UserRole
  status    MembershipStatus @default(ACTIVE)
  createdAt DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt DateTime         @updatedAt @db.Timestamptz(6)
  user      User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  org       Organization     @relation(fields: [orgId], references: [id], onDelete: Restrict)

  @@unique([userId, orgId], map: "uq_memberships_user_org")
  @@index([orgId], map: "idx_memberships_org_id")
  @@map("memberships")
}

// Customer Reviews (admin phase §7). A member of an organization submits a
// rating + text review of their company; it enters PENDING moderation and only
// PUBLISHED reviews are ever surfaced publicly. One active review per user per
// org (partial unique index below — Postgres 15+), preventing duplicate/spam
// submissions while still allowing a fresh review after the previous one is
// HIDDEN or FLAGGED by moderation.
model Review {
  id            String       @id @default(uuid()) @db.Uuid
  publicId      String?      @unique
  userId        String       @db.Uuid
  orgId         String       @db.Uuid
  rating        Int
  text          String
  status        ReviewStatus @default(PENDING)
  adminResponse String?
  moderatedById String?      @db.Uuid
  moderatedAt   DateTime?    @db.Timestamptz(6)
  createdAt     DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime     @updatedAt @db.Timestamptz(6)
  user          User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  org           Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)
  moderatedBy   User?        @relation("ReviewModerator", fields: [moderatedById], references: [id], onDelete: Restrict)

  @@index([orgId, status], map: "idx_reviews_org_status")
  @@index([userId], map: "idx_reviews_user_id")
  @@index([createdAt], map: "idx_reviews_created_at")
  @@map("reviews")
}

enum ReviewStatus {
  PENDING
  PUBLISHED
  HIDDEN
  FLAGGED
}
