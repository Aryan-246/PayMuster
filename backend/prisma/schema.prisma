generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id                   String                @id @default(uuid()) @db.Uuid
  name                 String
  logoUrl              String?
  gstin                String?
  subscriptionTier     String?
  createdAt            DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime              @updatedAt @db.Timestamptz(6)
  deletedAt            DateTime?             @db.Timestamptz(6)
  deleteReason         String?
  deletedBy            String?               @db.Uuid
  joinCode             String?               @unique
  referenceCode        String?               @unique
  status               CompanyStatus         @default(PENDING)
  publicId             String?               @unique
  advances             Advance[]
  assetAssignments     AssetAssignment[]
  assets               Asset[]
  attendanceRecords    AttendanceRecord[]
  auditLogs            AuditLog[]
  clients              Client[]
  joinRequests         CompanyJoinRequest[]
  settings             CompanySettings?
  correctionRequests   CorrectionRequest[]
  expenses             Expense[]
  holidays             Holiday[]
  invitations          Invitation[]
  materialStock        MaterialStock[]
  materialTransactions MaterialTransaction[]
  materials            Material[]
  notifications        Notification[]
  deviceTokens         DeviceToken[]
  notificationDeliveries NotificationDelivery[]
  announcementCampaigns AnnouncementCampaign[]
  payCycles             PayCycle[]
  payRunItems          PayRunItem[]
  payRuns              PayRun[]
  paymentApprovals     PaymentApproval[]
  payments             Payment[]
  financialAllocations FinancialAllocation[]
  expenseApprovals     ExpenseApproval[]
  financialEvidence    FinancialEvidence[]
  promotionRequests    PromotionRequest[]
  salaryRules          SalaryRule[]
  sessions             Session[]
  shifts               Shift[]
  siteAssignments      SiteAssignment[]
  siteMembers          SiteMember[]
  sites                Site[]
  staff                Staff[]
  staffDocuments       StaffDocument[]
  syncQueue            SyncQueue[]
  users                User[]
  vendorPayments       VendorPayment[]
  vendors              Vendor[]
  subscriptions        Subscription[]
  invoices             Invoice[]
  paymentEvents        PaymentEvent[]
  usageRecords         UsageRecord[]
  entitlements         Entitlement[]
  mailDispatches       MailDispatch[]
  memberships          Membership[]
  reviews              Review[]

  @@index([name], map: "idx_organizations_name")
  @@map("organizations")
}

model User {
  id                   String               @id @default(uuid()) @db.Uuid
  orgId                String?              @db.Uuid
  email                String?
  phone                String?
  passwordHash         String?
  role                 UserRole
  firstName            String?
  lastName             String?
  isActive             Boolean              @default(true)
  createdAt            DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime             @updatedAt @db.Timestamptz(6)
  deletedAt            DateTime?            @db.Timestamptz(6)
  avatarUrl            String?
  avatarStorageKey     String?
  deleteReason         String?
  deletedBy            String?              @db.Uuid
  emailVerified        Boolean              @default(false)
  isDisabled           Boolean              @default(false)
  lastLoginAt          DateTime?            @db.Timestamptz(6)
  provider             String?
  status               UserStatus           @default(PENDING)
  publicId             String?              @unique
  markedAttendance     AttendanceRecord[]   @relation("AttendanceMarkedBy")
  auditLogs            AuditLog[]
  authOtps             AuthOtp[]
  announcementCampaigns AnnouncementCampaign[] @relation("AnnouncementCampaignActor")
  announcementCampaignRecipients AnnouncementCampaign[] @relation("AnnouncementCampaignRecipient")
  reviewedDocuments    StaffDocument[] @relation("DocumentReviewer")
  joinRequests         CompanyJoinRequest[]
  requestedCorrections CorrectionRequest[]  @relation("CorrectionRequestedBy")
  resolvedCorrections  CorrectionRequest[]  @relation("CorrectionResolvedBy")
  expensesPaid         Expense[]
  invitationsSent      Invitation[]
  notifications        Notification[]
  deviceTokens          DeviceToken[]
  ownerRequests         OwnerRequest[]
  subscriptionChanges  Subscription[] @relation("SubscriptionChangedBy")
  createdAllocations   FinancialAllocation[] @relation("FinancialAllocationCreatedBy")
  expenseApprovals     ExpenseApproval[] @relation("ExpenseApprovalActor")
  uploadedEvidence     FinancialEvidence[] @relation("FinancialEvidenceUploadedBy")
  approvedPayRuns      PayRun[]             @relation("PayRunApprovedBy")
  paymentApprovals     PaymentApproval[]
  approvedPayments     Payment[]            @relation("PaymentApprovedBy")
  promotionRequests    PromotionRequest[]
  sessions             Session[]
  siteHistoryChanges   SiteHistory[]
  siteMembers          SiteMember[]
  syncQueue            SyncQueue[]
  memberships          Membership[]
  reviews              Review[]
  moderatedReviews    Review[]             @relation("ReviewModerator")
  org                  Organization?        @relation(fields: [orgId], references: [id], onDelete: Restrict)

  @@unique([orgId, email], name: "uq_users_org_id_email")
  @@unique([orgId, phone], name: "uq_users_org_id_phone")
  @@index([orgId], map: "idx_users_org_id")
  @@map("users")
}

model AuthOtp {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  otpHash      String
  purpose      String
  expiresAt    DateTime  @db.Timestamptz(6)
  used         Boolean   @default(false)
  usedAt       DateTime? @db.Timestamptz(6)
  resendCount  Int       @default(0)
  attemptCount Int       @default(0)
  createdAt    DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(6)
  user         User      @relation(fields: [userId], references: [id])

  @@index([userId], map: "idx_auth_otps_user_id")
  @@index([purpose], map: "idx_auth_otps_purpose")
  @@index([userId, purpose, createdAt], map: "idx_auth_otps_user_purpose_created_at")
  @@map("auth_otps")
}

model Session {
  id               String        @id @default(uuid()) @db.Uuid
  orgId            String?       @db.Uuid
  userId           String        @db.Uuid
  deviceInfo       String?
  ipAddress        String?
  refreshTokenHash String
  expiresAt        DateTime      @db.Timestamptz(6)
  revokedAt        DateTime?     @db.Timestamptz(6)
  createdAt        DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime      @updatedAt @db.Timestamptz(6)
  org              Organization? @relation(fields: [orgId], references: [id], onDelete: Restrict)
  user             User          @relation(fields: [userId], references: [id])

  @@index([orgId], map: "idx_sessions_org_id")
  @@index([userId], map: "idx_sessions_user_id")
  @@index([expiresAt], map: "idx_sessions_expires_at")
  @@map("sessions")
}

model AuditLog {
  id          String        @id @default(uuid()) @db.Uuid
  orgId       String?       @db.Uuid
  userId      String?       @db.Uuid
  action      AuditAction
  entityType  String
  entityId    String        @db.Uuid
  changes     Json
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime      @updatedAt @db.Timestamptz(6)
  afterValue  Json?
  beforeValue Json?
  browser     String?
  device      String?
  requestId   String?
  targetId    String?       @db.Uuid
  org         Organization? @relation(fields: [orgId], references: [id], onDelete: Restrict)
  user        User?         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([orgId], map: "idx_audit_logs_org_id")
  @@index([entityType, entityId], map: "idx_audit_logs_entity")
  @@map("audit_logs")
}

model Staff {
  id                     String             @id @default(uuid()) @db.Uuid
  orgId                  String             @db.Uuid
  firstName              String
  lastName               String
  phone                  String?
  email                  String?
  workerType             WorkerType
  status                 StaffStatus
  joinDate               DateTime?          @db.Timestamptz(6)
  bankAccountNumber      String?
  ifscCode               String?
  upiId                  String?
  preferredPaymentMethod String?
  createdAt              DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime           @updatedAt @db.Timestamptz(6)
  deletedAt              DateTime?          @db.Timestamptz(6)
  deleteReason           String?
  deletedBy              String?            @db.Uuid
  publicId               String?            @unique
  advances               Advance[]
  assetAssignments       AssetAssignment[]
  currentAssets          Asset[]
  attendanceRecords      AttendanceRecord[]
  payRunItems            PayRunItem[]
  payments               Payment[]
  salaryRules            SalaryRule[]
  siteAssignments        SiteAssignment[]
  org                    Organization       @relation(fields: [orgId], references: [id])
  documents              StaffDocument[]

  @@unique([orgId, email], name: "uq_staff_org_id_email")
  @@unique([orgId, phone], name: "uq_staff_org_id_phone")
  @@index([orgId], map: "idx_staff_org_id")
  @@map("staff")
}

model StaffDocument {
  id                String         @id @default(uuid()) @db.Uuid
  orgId             String         @db.Uuid
  staffId           String         @db.Uuid
  type              String
  fileUrl           String
  expiryDate        DateTime?      @db.Timestamptz(6)
  createdAt         DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime       @updatedAt @db.Timestamptz(6)
  deletedAt         DateTime?      @db.Timestamptz(6)
  deleteReason      String?
  deletedBy         String?        @db.Uuid
  status            DocumentStatus @default(PENDING)
  reviewerId        String?        @db.Uuid
  reviewedAt        DateTime?      @db.Timestamptz(6)
  rejectionReason   String?
  version           Int            @default(1)
  parentDocumentId  String?        @db.Uuid
  resubmissionCount Int            @default(0)
  originalFilename  String?
  mimeType          String?
  byteSize          Int?
  checksumSha256    String?
  org               Organization   @relation(fields: [orgId], references: [id])
  staff             Staff          @relation(fields: [staffId], references: [id])
  reviewer          User?          @relation("DocumentReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)
  parentDocument    StaffDocument? @relation("DocumentResubmissions", fields: [parentDocumentId], references: [id], onDelete: Restrict)
  resubmissions     StaffDocument[] @relation("DocumentResubmissions")

  @@index([orgId], map: "idx_staff_documents_org_id")
  @@index([staffId], map: "idx_staff_documents_staff_id")
  @@index([reviewerId], map: "idx_staff_documents_reviewer_id")
  @@index([parentDocumentId], map: "idx_staff_documents_parent_id")
  @@map("staff_documents")
}

model AnnouncementCampaign {
  id             String   @id @default(uuid()) @db.Uuid
  actorId        String   @db.Uuid
  orgId          String?  @db.Uuid
  title          String
  body           String
  type           String   @default("INFORMATION")
  audience       String
  audienceRole   UserRole?
  audienceUserId String?  @db.Uuid
  deepLink       String?
  recipientCount Int      @default(0)
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  actor          User     @relation("AnnouncementCampaignActor", fields: [actorId], references: [id], onDelete: Restrict)
  organization   Organization? @relation(fields: [orgId], references: [id], onDelete: Restrict)
  recipient      User?    @relation("AnnouncementCampaignRecipient", fields: [audienceUserId], references: [id], onDelete: Restrict)
  notifications  Notification[]

  @@index([orgId], map: "idx_announcement_campaign_org_id")
  @@index([actorId], map: "idx_announcement_campaign_actor_id")
  @@index([audienceUserId], map: "idx_announcement_campaign_user_id")
  @@map("announcement_campaigns")
}

model SalaryRule {
  id                         String         @id @default(uuid()) @db.Uuid
  orgId                      String         @db.Uuid
  staffId                    String         @db.Uuid
  rateType                   SalaryRateType
  amount                     Decimal
  effectiveDate              DateTime       @db.Timestamptz(6)
  maxAdvanceDeductionPercent Int
  isActive                   Boolean        @default(true)
  createdAt                  DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt                  DateTime       @updatedAt @db.Timestamptz(6)
  deletedAt                  DateTime?      @db.Timestamptz(6)
  deleteReason               String?
  deletedBy                  String?        @db.Uuid
  org                        Organization   @relation(fields: [orgId], references: [id])
  staff                      Staff          @relation(fields: [staffId], references: [id])

  @@index([orgId], map: "idx_salary_rules_org_id")
  @@index([staffId], map: "idx_salary_rules_staff_id")
  @@map("salary_rules")
}

model Shift {
  id              String       @id @default(uuid()) @db.Uuid
  orgId           String       @db.Uuid
  name            String
  startTime       String
  endTime         String
  gracePeriodMins Int
  createdAt       DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime     @updatedAt @db.Timestamptz(6)
  deletedAt       DateTime?    @db.Timestamptz(6)
  deleteReason    String?
  deletedBy       String?      @db.Uuid
  org             Organization @relation(fields: [orgId], references: [id])

  @@index([orgId], map: "idx_shifts_org_id")
  @@map("shifts")
}

model Holiday {
  id           String       @id @default(uuid()) @db.Uuid
  orgId        String       @db.Uuid
  date         DateTime     @db.Timestamptz(6)
  name         String
  multiplier   Float
  createdAt    DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime     @updatedAt @db.Timestamptz(6)
  deletedAt    DateTime?    @db.Timestamptz(6)
  deleteReason String?
  deletedBy    String?      @db.Uuid
  org          Organization @relation(fields: [orgId], references: [id])

  @@index([orgId], map: "idx_holidays_org_id")
  @@index([date], map: "idx_holidays_date")
  @@map("holidays")
}

model Site {
  id                   String                @id @default(uuid()) @db.Uuid
  orgId                String                @db.Uuid
  name                 String
  address              String?
  latitude             Float?
  longitude            Float?
  geoFenceRadius       Int?
  clientId             String?               @db.Uuid
  startDate            DateTime?             @db.Timestamptz(6)
  expectedEndDate      DateTime?             @db.Timestamptz(6)
  status               SiteStatus
  createdAt            DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime              @updatedAt @db.Timestamptz(6)
  deletedAt            DateTime?             @db.Timestamptz(6)
  deleteReason         String?
  deletedBy            String?               @db.Uuid
  publicId             String?               @unique
  assets               Asset[]
  attendanceRecords    AttendanceRecord[]
  expenses             Expense[]
  financialAllocations FinancialAllocation[]
  materialStock        MaterialStock[]
  materialTransactions MaterialTransaction[]
  siteAssignments      SiteAssignment[]
  siteHistory          SiteHistory[]
  siteMembers          SiteMember[]
  client               Client?               @relation(fields: [clientId], references: [id], onDelete: Restrict)
  org                  Organization          @relation(fields: [orgId], references: [id])

  @@index([orgId], map: "idx_sites_org_id")
  @@index([clientId], map: "idx_sites_client_id")
  @@map("sites")
}

model SiteAssignment {
  id           String       @id @default(uuid()) @db.Uuid
  orgId        String       @db.Uuid
  siteId       String       @db.Uuid
  staffId      String       @db.Uuid
  assignedAt   DateTime     @default(now()) @db.Timestamptz(6)
  removedAt    DateTime?    @db.Timestamptz(6)
  createdAt    DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime     @updatedAt @db.Timestamptz(6)
  deletedAt    DateTime?    @db.Timestamptz(6)
  deleteReason String?
  deletedBy    String?      @db.Uuid
  publicId     String?      @unique
  org          Organization @relation(fields: [orgId], references: [id])
  site         Site         @relation(fields: [siteId], references: [id])
  staff        Staff        @relation(fields: [staffId], references: [id])

  @@unique([siteId, staffId, assignedAt], name: "uq_site_assignments_site_staff_assigned_at")
  @@index([orgId], map: "idx_site_assignments_org_id")
  @@index([siteId], map: "idx_site_assignments_site_id")
  @@index([staffId], map: "idx_site_assignments_staff_id")
  @@map("site_assignments")
}

model AttendanceRecord {
  id                        String              @id @default(uuid()) @db.Uuid
  orgId                     String              @db.Uuid
  staffId                   String              @db.Uuid
  siteId                    String              @db.Uuid
  date                      DateTime            @db.Timestamptz(6)
  status                    AttendanceStatus
  checkInTime               DateTime?           @db.Timestamptz(6)
  checkOutTime              DateTime?           @db.Timestamptz(6)
  checkInLatitude           Float?
  checkInLongitude          Float?
  checkInAccuracyMeters     Float?
  checkInCapturedAt         DateTime?           @db.Timestamptz(6)
  checkInDistanceMeters     Float?
  checkInLocationValidation String?
  checkOutLatitude          Float?
  checkOutLongitude         Float?
  checkOutAccuracyMeters    Float?
  checkOutCapturedAt        DateTime?           @db.Timestamptz(6)
  checkOutDistanceMeters    Float?
  checkOutLocationValidation String?
  checkInPhotoUrl            String?
  checkOutPhotoUrl           String?
  shiftType          ShiftType
  overtimeHours      Float?
  markedById         String?             @db.Uuid
  notes              String?
  createdAt          DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime            @updatedAt @db.Timestamptz(6)
  deletedAt          DateTime?           @db.Timestamptz(6)
  deleteReason       String?
  deletedBy          String?             @db.Uuid
  publicId           String?             @unique
  markedBy           User?               @relation("AttendanceMarkedBy", fields: [markedById], references: [id], onDelete: Restrict)
  org                Organization        @relation(fields: [orgId], references: [id])
  site               Site                @relation(fields: [siteId], references: [id])
  staff              Staff               @relation(fields: [staffId], references: [id])
  correctionRequests CorrectionRequest[]

  @@index([orgId], map: "idx_attendance_records_org_id")
  @@index([staffId], map: "idx_attendance_records_staff_id")
  @@index([siteId], map: "idx_attendance_records_site_id")
  @@index([date], map: "idx_attendance_records_date")
  @@map("attendance_records")
}

model CorrectionRequest {
  id                 String           @id @default(uuid()) @db.Uuid
  orgId              String           @db.Uuid
  attendanceRecordId String           @db.Uuid
  requestedById      String           @db.Uuid
  requestedChanges   Json
  reason             String?
  status             CorrectionStatus
  resolvedById       String?          @db.Uuid
  resolvedAt         DateTime?        @db.Timestamptz(6)
  createdAt          DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime         @updatedAt @db.Timestamptz(6)
  deletedAt          DateTime?        @db.Timestamptz(6)
  deleteReason       String?
  deletedBy          String?          @db.Uuid
  attendanceRecord   AttendanceRecord @relation(fields: [attendanceRecordId], references: [id])
  org                Organization     @relation(fields: [orgId], references: [id])
  requestedBy        User             @relation("CorrectionRequestedBy", fields: [requestedById], references: [id])
  resolvedBy         User?            @relation("CorrectionResolvedBy", fields: [resolvedById], references: [id], onDelete: Restrict)

  @@index([orgId], map: "idx_correction_requests_org_id")
  @@index([attendanceRecordId], map: "idx_correction_requests_attendance_record_id")
  @@index([requestedById], map: "idx_correction_requests_requested_by_id")
  @@index([resolvedById], map: "idx_correction_requests_resolved_by_id")
  @@map("correction_requests")
}

model PayCycle {
  id           String         @id @default(uuid()) @db.Uuid
  orgId        String         @db.Uuid
  startDate    DateTime       @db.Timestamptz(6)
  endDate      DateTime       @db.Timestamptz(6)
  status       PayCycleStatus
  createdAt    DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime       @updatedAt @db.Timestamptz(6)
  deletedAt    DateTime?      @db.Timestamptz(6)
  deleteReason String?
  deletedBy    String?        @db.Uuid
  org          Organization   @relation(fields: [orgId], references: [id])
  payRuns      PayRun[]

  @@index([orgId], map: "idx_pay_cycles_org_id")
  @@index([startDate, endDate], map: "idx_pay_cycles_period")
  @@map("pay_cycles")
}

model PayRun {
  id           String       @id @default(uuid()) @db.Uuid
  orgId        String       @db.Uuid
  payCycleId   String       @db.Uuid
  totalAmount  Decimal
  approvedById String?      @db.Uuid
  approvedAt   DateTime?    @db.Timestamptz(6)
  createdAt    DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime     @updatedAt @db.Timestamptz(6)
  deletedAt    DateTime?    @db.Timestamptz(6)
  deleteReason String?
  deletedBy    String?      @db.Uuid
  publicId     String?      @unique
  payRunItems          PayRunItem[]
  financialAllocations FinancialAllocation[] @relation("AllocationPayRun")
  financialEvidence    FinancialEvidence[]
  approvedBy           User?        @relation("PayRunApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)
  org          Organization @relation(fields: [orgId], references: [id])
  payCycle     PayCycle     @relation(fields: [payCycleId], references: [id])

  @@index([orgId], map: "idx_pay_runs_org_id")
  @@index([payCycleId], map: "idx_pay_runs_pay_cycle_id")
  @@index([approvedById], map: "idx_pay_runs_approved_by_id")
  @@map("pay_runs")
}

model PayRunItem {
  id           String       @id @default(uuid()) @db.Uuid
  orgId        String       @db.Uuid
  payRunId     String       @db.Uuid
  staffId      String       @db.Uuid
  grossPay     Decimal
  deductions   Json
  additions    Json
  arrears      Json
  netPay       Decimal
  createdAt    DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime     @updatedAt @db.Timestamptz(6)
  deletedAt    DateTime?    @db.Timestamptz(6)
  deleteReason String?
  deletedBy    String?      @db.Uuid
  org          Organization @relation(fields: [orgId], references: [id])
  payRun       PayRun       @relation(fields: [payRunId], references: [id])
  staff        Staff        @relation(fields: [staffId], references: [id])

  @@index([orgId], map: "idx_pay_run_items_org_id")
  @@index([payRunId], map: "idx_pay_run_items_pay_run_id")
  @@index([staffId], map: "idx_pay_run_items_staff_id")
  @@map("pay_run_items")
}

model Payment {
  id               String            @id @default(uuid()) @db.Uuid
  orgId            String            @db.Uuid
  staffId          String            @db.Uuid
  amount           Decimal
  mode             PaymentMode
  referenceId      String?
  status           PaymentStatus
  approvedById     String?           @db.Uuid
  approvedAt       DateTime?         @db.Timestamptz(6)
  failureReason    String?
  createdAt        DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime          @updatedAt @db.Timestamptz(6)
  deletedAt        DateTime?         @db.Timestamptz(6)
  deleteReason     String?
  deletedBy        String?           @db.Uuid
  paymentApprovals     PaymentApproval[]
  financialAllocations FinancialAllocation[] @relation("AllocationPayment")
  financialEvidence    FinancialEvidence[] @relation("EvidencePayment")
  approvedBy           User?             @relation("PaymentApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)
  org              Organization      @relation(fields: [orgId], references: [id])
  staff            Staff             @relation(fields: [staffId], references: [id])

  @@index([orgId], map: "idx_payments_org_id")
  @@index([staffId], map: "idx_payments_staff_id")
  @@index([approvedById], map: "idx_payments_approved_by_id")
  @@map("payments")
}

model PaymentApproval {
  id           String                @id @default(uuid()) @db.Uuid
  orgId        String                @db.Uuid
  paymentId    String                @db.Uuid
  action       PaymentApprovalAction
  actorId      String                @db.Uuid
  notes        String?
  createdAt    DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime              @updatedAt @db.Timestamptz(6)
  deletedAt    DateTime?             @db.Timestamptz(6)
  deleteReason String?
  deletedBy    String?               @db.Uuid
  actor        User                  @relation(fields: [actorId], references: [id])
  org          Organization          @relation(fields: [orgId], references: [id])
  payment      Payment               @relation(fields: [paymentId], references: [id])

  @@index([orgId], map: "idx_payment_approvals_org_id")
  @@index([paymentId], map: "idx_payment_approvals_payment_id")
