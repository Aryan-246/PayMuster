PORT=4000
NODE_ENV=development
APP_URL=http://localhost:5173
DATABASE_URL="postgresql://user:password@localhost:5432/paymuster"
JWT_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
SESSION_EXPIRES_IN=7d
SESSION_REMEMBER_ME_EXPIRES_IN=30d
OTP_HASH_SECRET=replace-with-a-separate-long-random-secret
OTP_MAX_RESEND_ATTEMPTS=5
OTP_MAX_VERIFICATION_ATTEMPTS=5
EMAIL_USER=your-gmail-address@gmail.com
EMAIL_APP_PASSWORD=your-gmail-app-password
EMAIL_FROM="PayMuster <your-gmail-address@gmail.com>"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SUPPORT_EMAIL=support@paymuster.com
EMAIL_LOGO_URL=https://your-public-app-url/paymuster_logo.png
GOOGLE_WEB_CLIENT_ID=974622496145-uvhmg11i4jbuvdbu3i0hm8d0n08t896l.apps.googleusercontent.com
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
DOCUMENT_STORAGE_BUCKET="staff-documents-private"
DOCUMENT_UPLOAD_MAX_BYTES=10485760
DOCUMENT_SIGNED_URL_TTL_SECONDS=300
AVATAR_UPLOAD_MAX_BYTES=5242880
DOCUMENT_ALLOWED_MIME_TYPES="application/pdf,image/jpeg,image/png"

# Optional provider flags. Keep all vendor secrets server-side and disabled by default.
AI_ENABLED=false
GEMINI_API_KEY=replace-with-local-server-secret
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_MS=15000
SEARCH_ENABLED=false
ALGOLIA_APPLICATION_ID=replace-with-local-app-id
ALGOLIA_ADMIN_API_KEY=replace-with-server-only-key
ALGOLIA_SEARCH_ONLY_KEY=replace-with-search-only-key
ALGOLIA_INDEX_PREFIX=paymuster_dev
CLOUD_STORAGE_ENABLED=false
CLOUDINARY_CLOUD_NAME=replace-with-cloud-name
CLOUDINARY_API_KEY=replace-with-api-key
CLOUDINARY_API_SECRET=replace-with-server-only-secret
CLOUDINARY_URL=replace-with-server-only-url
REALTIME_ENABLED=false
STREAM_APP_ID=replace-with-app-id
STREAM_API_KEY=replace-with-api-key
STREAM_SECRET_KEY=replace-with-server-only-secret
CLERK_ENABLED=false
CLERK_PUBLISHABLE_KEY=replace-with-public-key
CLERK_SECRET_KEY=replace-with-server-only-secret
SMTP_ENABLED=false

# Payments: keep test mode until webhook, refund, reconciliation, and billing policy are verified.
RAZORPAY_ENABLED=false
RAZORPAY_MODE=test
RAZORPAY_KEY_ID=replace-with-test-key-id
RAZORPAY_KEY_SECRET=replace-with-server-only-test-secret
RAZORPAY_WEBHOOK_SECRET=replace-with-server-only-webhook-secret
RAZORPAY_TIMEOUT_MS=10000

# Push notifications: Firebase Admin credentials are server-only.
FCM_ENABLED=false
FIREBASE_PROJECT_ID=replace-with-project-id
FIREBASE_CLIENT_EMAIL=replace-with-service-account-email
FIREBASE_PRIVATE_KEY="replace-with-server-only-private-key"
FCM_TIMEOUT_MS=10000

# Maps/location validation. Site coordinates remain authoritative in the database.
GOOGLE_MAPS_ENABLED=false
GOOGLE_MAPS_API_KEY=replace-with-server-or-restricted-key

# Error reporting: send redacted events only; never include request bodies or credentials.
SENTRY_ENABLED=false
SENTRY_DSN=replace-with-sentry-dsn
SENTRY_ENVIRONMENT=development

# Optional infrastructure currently blocked unless explicitly approved and supported.
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379
TWILIO_ENABLED=false
TWILIO_ACCOUNT_SID=replace-with-account-sid
TWILIO_AUTH_TOKEN=replace-with-server-only-auth-token
AWS_ENABLED=false
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=replace-with-server-only-access-key
AWS_SECRET_ACCESS_KEY=replace-with-server-only-secret-key
